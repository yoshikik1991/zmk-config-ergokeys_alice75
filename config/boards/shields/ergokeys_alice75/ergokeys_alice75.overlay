
#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/led/led.h>
#include <physical_layouts.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
/* Reference: https://docs.zephyrproject.org/apidoc/latest/group__input__events.html */

#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>


#include "ergokeys_alice75_pinctrl.dtsi"

/ {
    chosen {
        zmk,physical-layout = &physical_layout0;
        zephyr,display = &oled;
    };

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "default_transform";

        kscan = <&kscan>;
        transform = <&matrix_transform0>;

        keys  //                     w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100   20    0       0     0     0>
            , <&key_physical_attrs 100 100  150    0       0     0     0>
            , <&key_physical_attrs 100 100  250    0       0     0     0>
            , <&key_physical_attrs 100 100  320   98    1200   800   330>
            , <&key_physical_attrs 100 100  420   98    1200   800   330>
            , <&key_physical_attrs 100 100  545   98    1200   800   330>
            , <&key_physical_attrs 100 100  645   98    1200   800   330>
            , <&key_physical_attrs 100 100  855  100 (-1200)   795   320>
            , <&key_physical_attrs 100 100  955  100 (-1200)   795   320>
            , <&key_physical_attrs 100 100 1080  100 (-1200)   795   320>
            , <&key_physical_attrs 100 100 1180  100 (-1200)   795   320>
            , <&key_physical_attrs 100 100 1250    0       0     0     0>
            , <&key_physical_attrs 100 100 1350    0       0     0     0>
            , <&key_physical_attrs 100 100 1480    0       0     0     0>
            , <&key_physical_attrs 125 125 1640   25       0     0     0>
            , <&key_physical_attrs 100 100   75  130       0     0     0>
            , <&key_physical_attrs 100 100  175  130       0     0     0>
            , <&key_physical_attrs 100 100  275  118       0     0     0>
            , <&key_physical_attrs 100 100  365  223    1200   800   330>
            , <&key_physical_attrs 100 100  465  223    1200   800   330>
            , <&key_physical_attrs 100 100  565  223    1200   800   330>
            , <&key_physical_attrs 100 100  665  223    1200   800   330>
            , <&key_physical_attrs 100 100  835  225 (-1200)   795   320>
            , <&key_physical_attrs 100 100  935  225 (-1200)   795   320>
            , <&key_physical_attrs 100 100 1035  225 (-1200)   795   320>
            , <&key_physical_attrs 100 100 1135  225 (-1200)   795   320>
            , <&key_physical_attrs 100 100 1225  118       0     0     0>
            , <&key_physical_attrs 100 100 1325  130       0     0     0>
            , <&key_physical_attrs 200 100 1425  130       0     0     0>
            , <&key_physical_attrs 150 100   50  230       0     0     0>
            , <&key_physical_attrs 100 100  200  230       0     0     0>
            , <&key_physical_attrs 100 100  310  323    1200   800   330>
            , <&key_physical_attrs 100 100  410  323    1200   800   330>
            , <&key_physical_attrs 100 100  510  323    1200   800   330>
            , <&key_physical_attrs 100 100  610  323    1200   800   330>
            , <&key_physical_attrs 100 100  780  325 (-1200)   795   320>
            , <&key_physical_attrs 100 100  880  325 (-1200)   795   320>
            , <&key_physical_attrs 100 100  980  325 (-1200)   795   320>
            , <&key_physical_attrs 100 100 1080  325 (-1200)   795   320>
            , <&key_physical_attrs 100 100 1180  325 (-1200)   795   320>
            , <&key_physical_attrs 100 100 1300  230       0     0     0>
            , <&key_physical_attrs 100 100 1400  230       0     0     0>
            , <&key_physical_attrs 150 100 1500  230       0     0     0>
            , <&key_physical_attrs 100 100 1675  205       0     0     0>
            , <&key_physical_attrs 175 100   25  330       0     0     0>
            , <&key_physical_attrs 100 100  200  330       0     0     0>
            , <&key_physical_attrs 100 100  335  423    1200   800   330>
            , <&key_physical_attrs 100 100  435  423    1200   800   330>
            , <&key_physical_attrs 100 100  535  423    1200   800   330>
            , <&key_physical_attrs 100 100  635  423    1200   800   330>
            , <&key_physical_attrs 100 100  805  425 (-1200)   795   320>
            , <&key_physical_attrs 100 100  905  425 (-1200)   795   320>
            , <&key_physical_attrs 100 100 1005  425 (-1200)   795   320>
            , <&key_physical_attrs 100 100 1105  425 (-1200)   795   320>
            , <&key_physical_attrs 100 100 1250  330       0     0     0>
            , <&key_physical_attrs 100 100 1350  330       0     0     0>
            , <&key_physical_attrs 225 100 1450  330       0     0     0>
            , <&key_physical_attrs 100 100 1705  305       0     0     0>
            , <&key_physical_attrs 225 100    0  430       0     0     0>
            , <&key_physical_attrs 100 100  225  430       0     0     0>
            , <&key_physical_attrs 100 100  385  523    1200   800   330>
            , <&key_physical_attrs 100 100  485  523    1200   800   330>
            , <&key_physical_attrs 100 100  585  523    1200   800   330>
            , <&key_physical_attrs 100 100  685  523    1200   800   330>
            , <&key_physical_attrs 100 100  730  525 (-1200)   795   320>
            , <&key_physical_attrs 100 100  830  525 (-1200)   795   320>
            , <&key_physical_attrs 100 100  930  525 (-1200)   795   320>
            , <&key_physical_attrs 100 100 1030  525 (-1200)   795   320>
            , <&key_physical_attrs 100 100 1130  525 (-1200)   795   320>
            , <&key_physical_attrs 100 100 1290  430       0     0     0>
            , <&key_physical_attrs 175 100 1390  430       0     0     0>
            , <&key_physical_attrs 100 100 1590  455       0     0     0>
            , <&key_physical_attrs 125 100    0  530       0     0     0>
            , <&key_physical_attrs 125 100  125  530       0     0     0>
            , <&key_physical_attrs 125 100  390  623    1200   800   330>
            , <&key_physical_attrs 225 100  515  623    1200   800   330>
            , <&key_physical_attrs 100 100  740  623    1200   800   330>
            , <&key_physical_attrs 275 100  830  625 (-1200)   795   320>
            , <&key_physical_attrs 100 100 1105  625 (-1200)   795   320>
            , <&key_physical_attrs 125 100 1350  530       0     0     0>
            , <&key_physical_attrs 100 100 1490  555       0     0     0>
            , <&key_physical_attrs 100 100 1590  555       0     0     0>
            , <&key_physical_attrs 100 100 1690  555       0     0     0>
            ;
    };

    matrix_transform0: matrix_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <7>;
        rows = <12>;          

        map = <
            RC(5,1)   RC(0,0)  RC(0,1)  RC(0,2)  RC(0,3)  RC(0,4)  RC(0,5)        RC(0,6)  RC(6,6)  RC(6,5)  RC(6,4)  RC(6,3)  RC(6,2)  RC(6,1)      RC(6,0)
            RC(5,0)    RC(1,0)  RC(1,1)  RC(1,2)  RC(1,3)  RC(1,4)  RC(1,5)        RC(1,6)  RC(7,6)  RC(7,5)  RC(7,4)  RC(7,3)  RC(7,2)     RC(7,1)
            RC(2,0)     RC(2,1)    RC(2,2)  RC(2,3)  RC(2,4)  RC(2,5)          RC(2,6)  RC(8,6)  RC(8,5)  RC(8,4)  RC(8,3)  RC(8,2)  RC(8,1)  RC(8,0)    RC(7,0)
            RC(3,0)      RC(3,1)    RC(3,2)  RC(3,3)  RC(3,4)  RC(3,5)           RC(3,6)  RC(9,6)  RC(9,5)  RC(9,4)        RC(9,3)  RC(9,2)    RC(9,1)     RC(9,0)
            RC(4,0)       RC(4,1)    RC(4,2)  RC(4,3)  RC(4,4)  RC(4,5)    RC(4,6)  RC(10,6)  RC(10,5)  RC(10,4)  RC(10,3)  RC(10,2)  RC(10,1)     RC(10,0)
            RC(5,2)  RC(5,3)       RC(5,4)         RC(5,5)        RC(5,6)                 RC(11,5)            RC(11,4)      RC(11,3)     RC(11,2)  RC(11,1)  RC(11,0)
        >;
    };

    kscan: kscan {
        compatible = "zmk,kscan-composite";
        label = "KSCAN";
        rows = <12>;
        columns = <7>;
        wakeup-source;
        key {
            kscan = <&kscan0>;
        };

    };

    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN_KEY";
        wakeup-source;
        diode-direction = "col2row";
        col-gpios
            = <&mcu_d 13  (GPIO_ACTIVE_HIGH)>
            , <&mcu_d 12  (GPIO_ACTIVE_HIGH) >
            , <&mcu_d 11  (GPIO_ACTIVE_HIGH)>
            , <&mcu_d 10  (GPIO_ACTIVE_HIGH)>
            , <&mcu_d 9   (GPIO_ACTIVE_HIGH)>
            , <&mcu_d 8   (GPIO_ACTIVE_HIGH)>
            , <&mcu_d 7   (GPIO_ACTIVE_HIGH)>
            ;
        row-gpios
            = <&mcu_d 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&mcu_d 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&mcu_d 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&mcu_d 23 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&mcu_d 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&mcu_d 25 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&mcu_d 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&mcu_d 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&mcu_d 17 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&mcu_d 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&mcu_d 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&mcu_d 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;

    };

    encoder: encoder {
        compatible = "alps,ec11";

        a-gpios = <&mcu_d 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&mcu_d 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <12>;
        status = "okay";

    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder>;
        triggers-per-rotation = <10>;
    };


};

&i2c0 {
    compatible = "nordic,nrf-twi";
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";
    status = "okay";
    
    oled: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        width = <128>;
        height = <32>;
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <31>;
        segment-remap;
        com-invdir;
        com-sequential;
        inversion-on;
        prechargep = <0x22>;
    };

};

&uart0 {
    compatible = "nordic,nrf-uarte";
    current-speed = <115200>;
    pinctrl-0 = <&uart0_default>;
    pinctrl-1 = <&uart0_sleep>;
    pinctrl-names = "default", "sleep";
    status="disabled";
};

&adc {
	status = "okay";
};

/ {
	anin0: analog_input_0 {
		compatible = "zmk,analog-input";
		sampling-hz = <1000>;
		y-ch {
			io-channels = <&adc 1>;
			mv-mid = <1540>;
			mv-min-max = <300>;
			mv-deadzone = <50>;
			scale-multiplier = <1>;
			scale-divisor = <1>;
			evt-type = <INPUT_EV_REL>;
			input-code = <INPUT_REL_Y>;
		};
		x-ch {
			io-channels = <&adc 0>;
			mv-mid = <1580>;
			mv-min-max = <300>;
			mv-deadzone = <50>;
			scale-multiplier = <1>;
			scale-divisor = <1>;
			evt-type = <INPUT_EV_REL>;
			input-code = <INPUT_REL_X>;
		};

	};
};

/ {
    joystick_listener {
        compatible = "zmk,input-listener";
        device = <&anin0>;
        input-processors = <&zip_xy_scaler 1 120>;

        sniper {
            layers = <1>;
            input-processors = <&zip_xy_scaler 1 500>;
        };

        scroller {
            layers = <2>;
            input-processors 
                = <&zip_xy_to_scroll_mapper>
                , <&zip_scroll_transform (INPUT_TRANSFORM_Y_INVERT)>
                , <&zip_scroll_scaler 1 10>;
        };
    };
};
