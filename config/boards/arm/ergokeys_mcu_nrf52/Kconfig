config BOARD_ENABLE_DCDC
    bool "Enable DCDC mode"
    select SOC_DCDC_NRF52X
    default y
    depends on (BOARD_ERGOKEYS_MCU_NRF52)

config BOARD_ENABLE_SOFTDEVICE
    bool "Enable Softdevice S140"
    default n
    depends on (BOARD_ERGOKEYS_MCU_NRF52)